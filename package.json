{
  "name": "production-platform",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @pp/server",
    "dev:client": "npm run dev -w @pp/client",
    "build": "npm run build -w @pp/client",
    "test": "npm test -w @pp/server",
    "test:api": "npm run test:api -w @pp/server",
    "typecheck": "npm run typecheck -w @pp/server && npm run typecheck -w @pp/client",
    "db:migrate": "npm run db:migrate -w @pp/server",
    "db:seed": "npm run db:seed -w @pp/server"
  }
}
